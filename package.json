{
  "name": "certiproof",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate && node scripts/assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "configure": "tsx scripts/configure.ts",
    "doctor": "node --conditions=react-server --import tsx scripts/manage.ts doctor",
    "setup": "node --conditions=react-server --import tsx scripts/manage.ts setup",
    "keys:generate": "node --conditions=react-server --import tsx scripts/manage.ts keys",
    "demo:prepare": "node --conditions=react-server --import tsx scripts/manage.ts demo",
    "demo:check": "node --conditions=react-server --import tsx scripts/manage.ts demo-check",
    "evidence:pack": "node --conditions=react-server --import tsx scripts/manage.ts pack",
    "notices:generate": "node scripts/notices.mjs",
    "secrets:check": "node scripts/scan-secrets.mjs",
    "github:inspect": "node scripts/github.mjs inspect",
    "github:publish": "node scripts/github.mjs publish",
    "deploy:check": "node --conditions=react-server --import tsx scripts/manage.ts check",
    "backup": "node --conditions=react-server --import tsx scripts/manage.ts backup",
    "restore:check": "node --conditions=react-server --import tsx scripts/manage.ts restore",
    "audit:ledger": "node --conditions=react-server --import tsx scripts/manage.ts audit",
    "audit:checkpoint": "node --conditions=react-server --import tsx scripts/manage.ts checkpoint",
    "maintenance:cleanup": "node --conditions=react-server --import tsx scripts/manage.ts cleanup",
    "operator:reset": "node --conditions=react-server --import tsx scripts/manage.ts reset",
    "check:release": "tsx scripts/release.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "1.3.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "canonicalize": "5.1.0",
    "jsqr": "1.4.0",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "regenerator-runtime": "0.14.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.7",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "node": "24.21.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
