# Stable production domain; localhost permitted only outside Vercel.
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Runtime certiproof_runtime role; Supavisor transaction pooler port 6543.
# Add ?pgbouncer=true&connection_limit=2&pool_timeout=10&sslmode=require
DATABASE_URL=
# Migration/owner role, direct or session pooler port 5432, not runtime credentials.
DIRECT_URL=
SUPABASE_SECRET_KEY=
CERTIFICATE_SIGNING_PRIVATE_KEY_B64=
SIGNING_KEY_ID=
TRUSTED_PUBLIC_KEYS_JSON=
# Random 32-byte abuse-counter salt; created by keys:generate.
ABUSE_HASH_SECRET=
# Operator identity (password entered in hidden prompt).
OPERATOR_EMAIL=
# Production smoke checks, not a secret.
TEST_BASE_URL=http://localhost:3000
# Integration tests require explicitly disposable hosted project.
DISPOSABLE_TEST_PROJECT=false
# Private browser test credentials, never publish:
TEST_OPERATOR_EMAIL=
TEST_OPERATOR_PASSWORD=
# Set only after corresponding documented evidence exists:
OWNER_SECOND_DEVICE_VERIFIED=false
REDEPLOY_PERSISTENCE_VERIFIED=false
DISPOSABLE_RESTORE_VERIFIED=false
# Restore targets are separate/empty/disposable:
RESTORE_DATABASE_URL=
RESTORE_SUPABASE_URL=
RESTORE_SUPABASE_SECRET_KEY=
DISPOSABLE_RESTORE_PROJECT=false
